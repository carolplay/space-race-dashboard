      "fraction": 0.5,
      "rounding": "floor",
      "source": "resolves 11b"
    },
    "m3": {
      "yearsAfterAnchor": 7,
      "fraction": 1,
      "toleranceSatellites": 1,
      "source": "resolves 4, 11c",
      "note": "Full filed count or count minus one, counting satellites per notified plane"
    },
    "reportSubmissionOffsetDays": 30,
    "modificationSubmissionOffsetDaysIfBelowThreshold": 90,
    "exceptions": "Resolve 12/RRB decisions and frequency-group differences must be checked; no automatic legal finding from arithmetic",
